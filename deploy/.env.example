# Copy to C:\CollectionMaxxing\.env and fill in. Never commit .env.
# CM_TAG is not here: the deployer passes the image tag (a git SHA) on every call.

# Database password. Pick a long random one (e.g. 32+ characters). Used only inside the compose network.
POSTGRES_PASSWORD=change-me

# Ports, all on 127.0.0.1. Never use 8080, 8409, 32400 or 8096: other apps on this PC own them.
CM_API_PORT=5480
CM_DASHBOARD_PORT=18888

# Folder for the auth0\ settings (deploy/auth0). Keep it readable only by your account.
CM_SECRETS_DIR=C:/CollectionMaxxing/secrets

# Sign-in through Auth0 (docs/07). All six values are required: the stack won't start without them.
# The address people browse to, with https:// and no trailing slash (placeholder shown).
CM_PUBLIC_ORIGIN=https://pc.tailnet.ts.net
# Your Auth0 tenant and the two apps deploy/auth0/Apply-Auth0.ps1 creates; it writes these values to
# <secrets folder>\auth0\api.env. The client secrets are secrets: never commit them.
CM_AUTH0_DOMAIN=your-tenant.us.auth0.com
CM_AUTH0_WEB_CLIENT_ID=change-me
CM_AUTH0_WEB_CLIENT_SECRET=change-me
CM_AUTH0_MANAGEMENT_CLIENT_ID=change-me
CM_AUTH0_MANAGEMENT_CLIENT_SECRET=change-me

# Google Books API key (optional): a second source for book lookups beside Open Library. Empty = off.
# Create it in Google Cloud (enable the Books API, restrict the key to it). A secret: never commit it.
CM_GOOGLE_BOOKS_API_KEY=

# IGDB client id and secret (optional but wanted: without them games have no title search and no box art,
# and game barcodes fall back to the UPC product's title alone). Free for non-commercial use: register an app
# at dev.twitch.tv/console (OAuth client credentials flow). Secrets: never commit them.
CM_IGDB_CLIENT_ID=
CM_IGDB_CLIENT_SECRET=

# TMDB API Read Access Token (optional but wanted: without it no DVD, VHS or Blu-ray cover finds its film or show).
# Free for non-commercial use: themoviedb.org/settings/api. The long token starting "eyJ" is preferred (it travels
# in a header); the short v3 API key works too. A secret: never commit it.
CM_TMDB_API_KEY=

# Where nightly backups go: a different drive from the Docker volumes on C:.
CM_BACKUP_DIR=F:/Backups/CollectionMaxxing
# Daily only, "minute hour * * *", in the time zone below (an IANA name such as Europe/Paris; UTC if unsure).
CM_BACKUP_SCHEDULE=0 3 * * *
CM_TZ=UTC

# Heartbeat check URL (for example from healthchecks.io). A missed night emails you. Empty = no pings.
# A failed backup pings this URL plus /fail.
CM_HEARTBEAT_URL=

# Recognition tuning (SCAN-2d): the folder holding recognition.json, the prompt, threshold and weight overrides
# the phone fetches from the API. Default ./recognition (a folder next to the compose file, mounted read-only at /config).
# CM_RECOGNITION_DIR=./recognition

# Recognition evals (owner only): the golden photos go in <dir>/golden/{shelf,single}, results land in <dir>/results.
# Default C:\CollectionMaxxing\evals (beside the repo clone; never inside it). Set CM_EVALS_ENABLED=false to turn the routes off.
# CM_EVALS_DIR=C:\CollectionMaxxing\evals
# CM_EVALS_ENABLED=true

# Old images (read by the deployer, not by the stack): after a good deploy it removes old api, migrate and backup
# images, keeping the running one, the previous one and the 3 newest of each. 0 switches that off (README, "Old images").
# CM_PRUNE_IMAGES=1

# Alert issues (read by the deployer, not by the stack): a failed deploy, a refused one or a stale backup opens a labeled
# GitHub issue through gh, once per problem, and closes it when the problem clears. 0 switches that off; the log line and
# the heartbeat ping stay (README, "Alerts as GitHub issues").
# CM_ALERT_ISSUES=1

# The issue agent (read by deploy/agent/Watch-AgentIssues.ps1, not by the stack; README, "The issue agent"): every 5 minutes
# a scheduled task looks for open issues labelled agent-task and runs one Claude Code agent per issue. Nothing runs while
# there is no work. Install it with deploy/agent/Install-AgentWatcher.ps1. Each setting is optional.
# On unless 0, false, off or no. A run already going is not stopped by this.
# CM_AGENT_ENABLED=1
# Your own checkout, where the agent makes its git worktrees. Never C:\CollectionMaxxing\repo (the deployer's clone: refused).
# Default: <your home folder>\source\repos\CollectionMaxxing
# CM_AGENT_REPO=C:\path\to\your\CollectionMaxxing
# Most runs started in one local day (0 pauses new runs), and the longest one run may take before it is stopped.
# CM_AGENT_MAX_RUNS_PER_DAY=8
# CM_AGENT_MAX_MINUTES=180
# Not a setting, a file: the agent's Claude Code sign-in. Run `claude setup-token` once and save the token it prints as the only
# line of agent\claude-token inside CM_SECRETS_DIR (above). Without it the agent uses the CLI's own sign-in, which lapses while
# it sits idle, and a signed-out CLI opens an alert issue instead of running (README, "Keep it signed in (once)").
