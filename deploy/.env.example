# Copy to C:\CollectionMaxxing\.env and fill in. Never commit .env.
# CM_TAG is not here: the deployer passes the image tag (a git SHA) on every call.

# Database password. Pick a long random one (e.g. 32+ characters). Used only inside the compose network.
POSTGRES_PASSWORD=change-me

# Ports, all on 127.0.0.1. Never use 8080, 8409, 32400 or 8096: other apps on this PC own them.
CM_API_PORT=5480
CM_DASHBOARD_PORT=18888

# Folder for the one-time setup code and the auth0\ settings (deploy/auth0). Keep it readable only by your account.
CM_SECRETS_DIR=C:/CollectionMaxxing/secrets

# Sign-in through Auth0 (docs/07). All six values are required: the stack won't start without them.
# The address people browse to, with https:// and no trailing slash (placeholder shown).
CM_PUBLIC_ORIGIN=https://pc.tailnet.ts.net
# Your Auth0 tenant and the two apps deploy/auth0/Apply-Auth0.ps1 creates; it writes these values to
# <secrets folder>\auth0\api.env. The client secrets are secrets: never commit them.
CM_AUTH0_DOMAIN=your-tenant.us.auth0.com
CM_AUTH0_WEB_CLIENT_ID=change-me
CM_AUTH0_WEB_CLIENT_SECRET=change-me
CM_AUTH0_MANAGEMENT_CLIENT_ID=change-me
CM_AUTH0_MANAGEMENT_CLIENT_SECRET=change-me

# Where nightly backups go: a different drive from the Docker volumes on C:.
CM_BACKUP_DIR=F:/Backups/CollectionMaxxing
# Daily only, "minute hour * * *", in the time zone below (an IANA name such as Europe/Paris; UTC if unsure).
CM_BACKUP_SCHEDULE=0 3 * * *
CM_TZ=UTC

# Heartbeat check URL (for example from healthchecks.io). A missed night emails you. Empty = no pings.
# A failed backup pings this URL plus /fail.
CM_HEARTBEAT_URL=

# Recognition evals (owner only): the golden photos go in <dir>/golden/{shelf,single}, results land in <dir>/results.
# Default C:\CollectionMaxxing\evals (beside the repo clone; never inside it). Set CM_EVALS_ENABLED=false to turn the routes off.
# CM_EVALS_DIR=C:\CollectionMaxxing\evals
# CM_EVALS_ENABLED=true
