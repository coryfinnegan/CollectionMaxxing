# Copy to C:\CollectionMaxxing\.env and fill in. Never commit .env.
# CM_TAG is not here: the deployer passes the image tag (a git SHA) on every call.

# Database password. Pick a long random one (e.g. 32+ characters). Used only inside the compose network.
POSTGRES_PASSWORD=change-me

# Ports, all on 127.0.0.1. Never use 8080, 8409, 32400 or 8096: other apps on this PC own them.
CM_API_PORT=5480
CM_DASHBOARD_PORT=18888

# The name people browse to: this PC's Tailscale name (placeholder shown). It cannot change later without losing every passkey.
CM_RELYING_PARTY_ID=pc.tailnet.ts.net
# Folder with openiddict-signing.pfx and openiddict-encryption.pfx (make them with deploy/deployer/New-Secrets.ps1). The
# one-time setup code is written here too. Keep it readable only by your account.
CM_SECRETS_DIR=C:/CollectionMaxxing/secrets
# Password of the two .pfx files; leave empty if they have none.
CM_CERT_PASSWORD=

# Where nightly backups go: a different drive from the Docker volumes on C:.
CM_BACKUP_DIR=F:/Backups/CollectionMaxxing
# Daily only, "minute hour * * *", in the time zone below (an IANA name such as Europe/Paris; UTC if unsure).
CM_BACKUP_SCHEDULE=0 3 * * *
CM_TZ=UTC

# Heartbeat check URL (for example from healthchecks.io). A missed night emails you. Empty = no pings.
# A failed backup pings this URL plus /fail.
CM_HEARTBEAT_URL=
