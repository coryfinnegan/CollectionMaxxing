<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- xUnit v3 test projects are executables. TestSupport is a plain library. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'CollectionMaxxing.TestSupport'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

</Project>
