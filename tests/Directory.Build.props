<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- xUnit v3 test projects are executables. TestSupport and Api.TestKit are plain libraries. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'CollectionMaxxing.TestSupport' And '$(MSBuildProjectName)' != 'CollectionMaxxing.Api.TestKit'">
    <OutputType>Exe</OutputType>
  </PropertyGroup>

</Project>
